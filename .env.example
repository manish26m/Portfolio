# Environment Variables

# 1. Database (Neon PostgreSQL)
# Get this from https://neon.tech
DATABASE_URL="postgresql://user:password@ep-host.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-host.region.aws.neon.tech/dbname?sslmode=require"

# 2. Authentication
# Generate a secure random string for this (e.g., openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# 3. Cloudinary (Image Storage)
# Get these from https://cloudinary.com
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# 4. Email (Resend)
# Get this from https://resend.com
RESEND_API_KEY="re_your_api_key_here"
# Optional: Set this if you want emails to go somewhere other than the email set in Admin Settings
ADMIN_EMAIL="your@email.com"

# 5. Site Configuration
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
